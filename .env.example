# Copy to .env and adjust as needed. Every value below is a default.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST=localhost
# Matches the host port published by docker-compose.yml.
POSTGRES_PORT=5433
# Set to true to run against a local SQLite file instead (used by the test suite).
USE_SQLITE=false

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Ingestion ---
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=300

# --- Embeddings ---
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_CHUNK_INDEX=rag_chunks

# --- Retrieval ---
RETRIEVAL_MODE=hybrid
RETRIEVAL_DENSE_K=30
RETRIEVAL_BM25_K=30
RETRIEVAL_FINAL_K=20
RETRIEVAL_CONTEXT_K=5
RRF_K=60

# --- Reranking ---
RERANK_ENABLED=true
# cross_encoder | identity (identity keeps input order, for offline work)
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16
RERANK_TOP_K=5

# --- Generation: gemini | ollama | stub ---
LLM_PROVIDER=ollama
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_HISTORY_TURNS=4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Streamlit UI ---
RAG_API_URL=http://localhost:8000
